    "Im Pool-User steht eine Adresse, aber kein Empfänger im Block passt dazu. Findet dein Miner diesen Block, geht die Belohnung an andere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Pool-User steht eine Adresse, aber kein Empfänger im Block passt dazu. Findet dein Miner diesen Block, geht die Belohnung an andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pool user contains an address, but no recipient in the block matches it. If your miner finds this block, the reward goes to someone else."
          }
        }
      }
    },
    "Im Pool-User steht keine Adresse, sondern ein Kontoname. Der Pool zahlt dann selbst aus, im Block steht nur seine Adresse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Pool-User steht keine Adresse, sondern ein Kontoname. Der Pool zahlt dann selbst aus, im Block steht nur seine Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pool user is an account name, not an address. The pool pays out itself, so only its own address is in the block."
          }
        }
      }
    },
