        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tasks yet. Use the plus at the top to add, for example, “Clean the fan” every 90 days. MinerGuru reminds you when a task is due."
          }
        }
      }
    },
