    "Staub am Lüfter kostet Drehzahl und treibt die Temperatur hoch. Nur im Stillstand reinigen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staub am Lüfter kostet Drehzahl und treibt die Temperatur hoch. Nur im Stillstand reinigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dust on the fan costs speed and drives up the temperature. Clean it only when it has stopped."
          }
        }
      }
    },
    "Steigt die Temperatur bei gleichem Takt, ist die Paste oft trocken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steigt die Temperatur bei gleichem Takt, ist die Paste oft trocken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the temperature rises at the same frequency, the paste has often dried out."
          }
        }
      }
    },
    "Stell Miner automatisch um, zum Beispiel nachts und am Wochenende auf einen Solo-Pool und morgens zurück. Jeder Wechsel ist ein eigener Eintrag; der Miner startet dabei kurz neu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell Miner automatisch um, zum Beispiel nachts und am Wochenende auf einen Solo-Pool und morgens zurück. Jeder Wechsel ist ein eigener Eintrag; der Miner startet dabei kurz neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move miners automatically, for example to a solo pool on nights and weekends and back in the morning. Each switch is its own entry; the miner restarts briefly."
          }
        }
      }
    },
