          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne sie meldet der Miner nicht, wer die Belohnung bekommt, und prüft deine Adresse nicht. Du kannst sie in der Weboberfläche des Miners bei den Pool-Einstellungen einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
