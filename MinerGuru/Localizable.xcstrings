    "Your pool user contains an address, but no recipient in the block matches it. If your miner finds this block, the reward goes to someone else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Pool-User steht eine Adresse, aber kein Empfänger im Block passt dazu. Findet dein Miner diesen Block, geht die Belohnung an andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pool user contains an address, but no recipient in the block matches it. If your miner finds this block, the reward goes to someone else."
          }
        }
      }
    },
    "Your pool user is an account name, not an address. The pool pays out itself, so only its own address is in the block." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
